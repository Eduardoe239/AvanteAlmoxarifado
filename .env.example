# Copie para .env e configure valores exclusivos para seu ambiente.
POSTGRES_PASSWORD=defina-uma-senha-forte
SECRET_KEY=gere-uma-chave-secreta-longa-e-aleatoria
NEXT_PUBLIC_API_URL=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:3000
COOKIE_SECURE=false

# Notificações por e-mail (configure para ativar envios reais)
EMAIL_HABILITADO=false
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
EMAIL_USE_TLS=true
EMAIL_SENDER=no-reply@suaorg.com
EMAIL_PASSWORD=
OCR_LANG=por+eng
