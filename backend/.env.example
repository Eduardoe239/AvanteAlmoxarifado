# Copie este arquivo para .env e preencha com valores reais.
# NUNCA commite o .env de verdade no git.

# String de conexão do PostgreSQL (obrigatório).
# Formato: postgresql://usuario:senha@host:porta/nome_banco
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/almoxarifado

# Gere uma chave forte com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-por-uma-chave-aleatoria-de-64-caracteres

# Tempo de expiração do token de acesso, em minutos.
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Domínios do frontend autorizados a chamar essa API, separados por vírgula.
ALLOWED_ORIGINS=http://localhost:3000

# Controla a flag Secure do cookie de sessão. Em produção (servido via
# HTTPS) mantenha "true" — o navegador só envia o cookie por HTTPS.
# Só use "false" em desenvolvimento local puro HTTP (http://localhost).
# NUNCA defina como "false" em produção.
COOKIE_SECURE=false

# --- Notificações por e-mail (opcional) ---
# Enquanto EMAIL_HABILITADO for "false", nenhum e-mail é enviado e o
# agendador nem chega a iniciar — o sistema funciona normalmente, só sem
# os avisos automáticos de devolução.
EMAIL_HABILITADO=false

# Servidor SMTP usado para enviar os avisos.
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
EMAIL_USE_TLS=true

# Remetente e credencial. No Gmail, use uma "senha de app" (App Password),
# nunca a senha principal da conta.
EMAIL_SENDER=no-reply@suaorg.com
EMAIL_PASSWORD=
